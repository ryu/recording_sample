<h1>New Document</h1>

<%= form_with model: @document do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :body %>
    <%= form.text_area :body %>
  </div>

  <%= form.submit "Create Document" %>
<% end %>

<p>
  <%= link_to "Back", recordings_path %>
</p>
