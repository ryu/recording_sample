<h1>New Recording</h1>

<h2>Document</h2>

<%= form_with url: recordings_path do |f| %>
  <div>
    <label>Title</label>
    <%= text_field_tag "document[title]", @document&.title %>
  </div>

  <div>
    <label>Body</label>
    <%= text_area_tag "document[body]", @document&.body %>
  </div>

  <%= f.submit "Create Document" %>
<% end %>

<hr>

<h2>Article</h2>

<%= form_with url: recordings_path do |f| %>
  <div>
    <label>Title</label>
    <%= text_field_tag "article[title]", @article&.title %>
  </div>

  <div>
    <label>URL</label>
    <%= url_field_tag "article[url]", @article&.url %>
  </div>

  <div>
    <label>Body</label>
    <%= text_area_tag "article[body]", @article&.body %>
  </div>

  <%= f.submit "Create Article" %>
<% end %>

<p>
  <%= link_to "Back", recordings_path %>
</p>
