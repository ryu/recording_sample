<h1><%= @recording.recordable.title %></h1>

<% if @recording.article? && @recording.recordable.url.present? %>
  <p>
    <%= link_to @recording.recordable.url, @recording.recordable.url, target: "_blank", rel: "noopener" %>
  </p>
<% end %>

<p>
  <%= @recording.recordable.body %>
</p>

<h2>History</h2>

<ul>
  <% @recording.events.recent.each do |e| %>
    <li>
      <%= e.action_label %>
      <% if e.title_changed? %>
        （title）
      <% end %>
      —
      <%= e.recordable_title %>
      <% if e.actor_label %>
        by <%= e.actor_label %>
      <% end %>
      （<%= l e.created_at, format: :short %>）
    </li>
  <% end %>
</ul>

<p>
  <%= link_to "Edit", edit_recording_path(@recording) %> |
  <%= link_to "Delete",
              recording_path(@recording),
              data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %> |
  <%= link_to "Back", recordings_path %>
</p>

<% if @recording.deleted? %>
  <p>
    <%= button_to "Restore", restore_recording_path(@recording), method: :post %>
  </p>
<% end %>
