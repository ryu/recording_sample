<h1><%= @recording.recordable.title %></h1>

<% if @recording.article? && @recording.recordable.url.present? %>
  <p>
    <%= link_to @recording.recordable.url, @recording.recordable.url, target: "_blank", rel: "noopener" %>
  </p>
<% end %>

<p>
  <%= @recording.recordable.body %>
</p>

<h2>History</h2>

<ul>
  <%= render @events %>
</ul>

<p>
  <% if @recording.deleted? %>
    <%= button_to "Restore", recording_restoration_path(@recording) %> |
  <% else %>
    <%= link_to "Edit", edit_recording_path(@recording) if @recording.document? %> |
    <%= link_to "Delete", @recording,
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %> |
  <% end %>
  <%= link_to "Back", recordings_path %>
</p>
